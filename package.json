{
	"name": "dual-dub",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"description": "Two dubs of one video at once: one in the left ear, another in the right",
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "pnpm run /^dev:/",
		"dev:chrome": "wxt -b chrome",
		"dev:firefox": "wxt -b firefox",
		"build": "pnpm build:chrome && pnpm build:firefox",
		"build:chrome": "wxt build -b chrome",
		"build:firefox": "wxt build -b firefox",
		"zip": "pnpm zip:chrome && pnpm zip:firefox",
		"zip:chrome": "wxt zip -b chrome",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "vue-tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"test": "vitest run",
		"postinstall": "wxt prepare",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/vue": "1.61.0",
		"@vueuse/core": "14.4.0",
		"shonk-ui": "0.14.0",
		"vue": "3.5.44"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tednaaa/eslint-config": "0.1.1",
		"@wxt-dev/module-vue": "1.0.3",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"lefthook": "2.1.16",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12",
		"vue-tsc": "3.3.13",
		"web-ext": "10.8.0",
		"wxt": "0.21.4"
	}
}
